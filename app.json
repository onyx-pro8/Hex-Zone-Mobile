{
  "expo": {
    "name": "Safe Zone Patrol",
    "slug": "safe-zone-patrol",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "safezonepatrol",
      "zoneweaver"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neighbourhoodassistant.safe-zone-patrol",
      "associatedDomains": [
        "applinks:safe-zone-patrol-server.onrender.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSCameraUsageDescription": "Safe Zone Patrol uses your camera to scan QR codes for zone access and member invites.",
        "NSPhotoLibraryUsageDescription": "Safe Zone Patrol uses your photo library so you can attach images to messages and update your profile photo.",
        "NSLocationWhenInUseUsageDescription": "Safe Zone Patrol uses your location to show the map around you and to anchor proximity-source zones.",
        "NSMicrophoneUsageDescription": "Safe Zone Patrol uses the microphone so you can speak with a guest or an administrator.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.safezonepatrol.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "safe-zone-patrol-server.onrender.com",
              "pathPrefix": "/access"
            },
            {
              "scheme": "https",
              "host": "safe-zone-patrol-server.onrender.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F80ED",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Safe Zone Patrol to access your camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Safe Zone Patrol uses your photo library so you can attach images to messages and update your profile photo.",
          "cameraPermission": "Safe Zone Patrol uses your camera to take photos for messages and your profile."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-splash-screen",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Safe Zone Patrol uses your location to show the map around you and to anchor proximity-source zones."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "https://safe-zone-patrol-server.onrender.com/",
      "webAppBaseUrl": "https://safe-zone-patrol-server.onrender.com/",
      "eas": {
        "projectId": "dee01d2e-c0f1-46dc-8a38-08f7736d4a12"
      }
    },
    "owner": "ihnatenkoandrii8s-organization"
  }
}
